KC_DB=postgres
KC_DB_URL=jdbc:postgresql://postgres:5432/keycloak
KC_DB_USERNAME=keycloak_user
KC_DB_PASSWORD=

KC_HOSTNAME=https://id.example.com
KC_HTTP_ENABLED=true
KC_PROXY_HEADERS=xforwarded
# Address(es) of the reverse proxy. Without it, any client that reaches Keycloak directly can spoof X-Forwarded-For.
KC_PROXY_TRUSTED_ADDRESSES=

KC_BOOTSTRAP_ADMIN_USERNAME=initial-admin
KC_BOOTSTRAP_ADMIN_PASSWORD=
